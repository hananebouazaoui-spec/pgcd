    // PGCD classique
    int temp_a = a, temp_b = b;
    while (temp_b != 0) {
        r = temp_a % temp_b;
        printf("%d = %d * (%d / %d) + %d\n", temp_a, temp_b, temp_a, temp_b, r);
        temp_a = temp_b;
        temp_b = r;
        operations++;
    }
    int d = temp_a;

    // Extended Euclid
    int gcd = extendedEuclid(a, b, &x, &y);



    printf("\t #Resultat PGCD : %d\n", gcd);

    if (gcd == 1)
        printf(" Les nombres sont premiers entre eux !\n");
    else {
        printf("-Les nombres ne sont pas premiers entre eux.\n");
        printf("x et y qui verifient a*x + b*y = PGCD(a,b) : x = %d, y = %d\n", x, y);
    }

    // Vérification existence solution
    if (c % gcd != 0) {
        printf("-Pas de solution entiere\n");
    } else {
        printf("-Il existe des solutions entieres\n");

        // Solution particulière
        int factor = c / gcd;
        xp = x * factor;
        yp = y * factor;

        printf("Solution particuliere : x = %d, y = %d\n", xp, yp);
        printf("Forme generale : x = %d + (%d)*k, y = %d - (%d)*k, \n",
               xp, b/gcd, yp, a/gcd);

        // ★★★ Extraction des solutions positives ★★★
    printf("\n LES Solutions positives d'equation (x > 0 et y > 0) .\n");

        int stepX = b / gcd;
        int stepY = a / gcd;

        int found = 0;

        for (int k = -10000; k <= 10000; k++) {
            int X = xp + stepX * k;
            int Y = yp - stepY * k;

            if (X > 0 && Y > 0) {
                printf("\t _ Solution : x = %d, y = %d (k = %d)\n", X, Y, k);
